# Copy to .env.local for development. Never commit real values.

# App
# Public URL of the site, read at runtime by the server (canonical links, sitemap, e-mails)
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development
TZ=Africa/Lubumbashi

# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/portfolio
TEST_DATABASE_URL=postgres://postgres:password@localhost:5432/portfolio_test
DATABASE_POOL_MAX=5

# Auth (home made)
# 32 bytes in base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_ENCRYPTION_KEY=
# Optional secret mixed into passwords before hashing
AUTH_PEPPER=
ADMIN_EMAIL=akonkwaushindi@gmail.com
TRUST_PROXY=true

# Cron (only when tasks are called over HTTP on /api/cron/*)
CRON_SECRET=

# SMTP (Nodemailer), use an address on the site domain with SPF, DKIM and DMARC
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Isaac Akonkwa <contact@example.com>"
MAIL_REPLY_TO=

# IMAP (optional, fetches replies)
IMAP_HOST=
IMAP_USER=
IMAP_PASS=

# Anti spam
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:akonkwaushindi@gmail.com

# Storage
STORAGE_DRIVER=local
DATA_DIR=/home/cpanel_user/portfolio_data
UPLOADS_DIR=/home/cpanel_user/portfolio_data/uploads
# Visitor attachments (quote requests), never served publicly
PRIVATE_DIR=/home/cpanel_user/portfolio_data/private
# Without SMTP_HOST, e-mails are written here as .eml files (development)
MAIL_OUTBOX_DIR=/home/cpanel_user/portfolio_data/mail-outbox
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Monitoring
MONITORING_TRANSPORT=local
BATELA_ENDPOINT=
BATELA_API_KEY=
GEOIP_DB_PATH=/home/cpanel_user/portfolio_data/GeoLite2-City.mmdb
MAXMIND_LICENSE_KEY=
IP_HASH_SALT_SECRET=
# none | cloudflare | htaccess
BAN_SYNC=none
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
HTACCESS_PATH=/home/cpanel_user/public_html/.htaccess
