#!/bin/sh
# Commit messages follow "type: description" and contain no forbidden character.
msg_file="$1"
first_line=$(head -n 1 "$msg_file")
case "$first_line" in
  Merge*|Revert*) ;;
  *)
    if ! echo "$first_line" | grep -Eq '^(feat|fix|refactor|chore|update|docs|test|perf|style|build|ci|revert)(\([a-z0-9-]+\))?: .+'; then
      echo "Message de commit invalide. Format attendu : type: description (feat, fix, refactor, chore, update, docs, test, perf, style, build, ci)."
      exit 1
    fi
    ;;
esac
pnpm -s exec tsx scripts/forbidden-chars.ts --any "$msg_file"
